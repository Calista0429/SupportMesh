# SupportMesh environment variables
# Copy this file to .env and fill in the real values:  cp .env.example .env
#
# Every variable below is read by the code or by docker-compose.yml. Values shown
# are the defaults that apply when the variable is unset.

# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV=development enables uvicorn auto-reload; anything else disables it.
APP_ENV=production
LOG_LEVEL=INFO

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# Required. The service refuses to start without it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model (default claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: point at an Anthropic-compatible third-party API, e.g. DeepSeek.
# Setting this also disables the remote embedding path, since compatible APIs
# generally do not expose an embeddings endpoint.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── Redis (working memory) ────────────────────────────────────────────────────
# Default inside Docker: redis://redis:6379/0
# For a local run outside Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose.yml for the Redis server and its health check.
REDIS_PASSWORD=change_this_in_production

# ── ChromaDB (episodic memory, user profile, knowledge base) ───────────────────
# Default inside Docker: chromadb / 8000. Locally: localhost / 8001.
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Local fallback path used when the ChromaDB service is unreachable.
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── Monitoring ────────────────────────────────────────────────────────────────
# 0 or unset leaves the Prometheus exporter off.
PROMETHEUS_PORT=9091
# Seconds between metric collection cycles.
MONITOR_INTERVAL=10
# Optional webhook for threshold alerts. Leave empty to disable.
ALERT_WEBHOOK_URL=

# ── Evaluation ────────────────────────────────────────────────────────────────
# Regression baseline written and read by /eval/run.
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ────────────────────────────────────────────────────────────────────
# Loaded at startup and hot-reloadable at runtime via POST /skills/reload.
SUPPORTMESH_SKILLS_DIR=./skills
SUPPORTMESH_SKILLS_MAX_PROMPT_CHARS=5000

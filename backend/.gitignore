# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/


# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment files (API keys and passwords -- never commit) ────────────────
.env
.env.*
!.env.example

# ── Runtime artifacts ─────────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
.DS_Store

# ── Local data: the ChromaDB store is a binary artifact, rebuildable from the knowledge base ─
data/chroma/
*.sqlite3
*.db

# ── Test and lint caches ──────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Operating system ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Backup files ──────────────────────────────────────────────────────────────
*~
*.bak
*.orig
